# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
CLOUDWATCH_LOG_GROUP=/incident-agent/app-logs
CLOUDWATCH_METRIC_NAMESPACE=IncidentAgent
EC2_INSTANCE_ID=i-0xxxxxxxxxxxxxxxxx
ECS_CLUSTER=my-cluster
ECS_SERVICE=my-service

# ── Databases ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=incident_agent

# ── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8001

# ── Detection thresholds ─────────────────────────────────────────────────────
CPU_THRESHOLD_PCT=85.0
MEMORY_THRESHOLD_PCT=85.0
DB_CONNECTIONS_THRESHOLD=80
RESTART_COUNT_THRESHOLD=3
ERROR_RATE_THRESHOLD=0.10

# ── Polling ──────────────────────────────────────────────────────────────────
CLOUDWATCH_POLL_INTERVAL=30
METRIC_WINDOW_SECONDS=300

# ── Misc ─────────────────────────────────────────────────────────────────────
REPORTS_DIR=reports
LOG_LEVEL=INFO
